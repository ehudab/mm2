;(cal_binomial (db_size $db) (n_conjuncts_new $pattern))
;(n! / (k! (n-k)!))

; Overflow danger zone: n≥67 when k≈n/2


; Calculates the binomial coefficient,
; First it calculates the permutations of P(n, k) and P(k, k) then divides them


((cal_binomial ($n $k))
    (, (permutation0 $p $t))
    (O
        (+ (permutation ($n $k)))
        (+ (permutation ($k $k)))
        
        (+ 
            (exec 0 
                (, (permutation0 $p $t)) 
                (, (exec 1 $p $t))
            )
        )
        (+
            (exec 2
                (, (permutation ($n $k) $p1) (permutation ($k $k) $p2))
                (O
                    (pure
                        (cal_binomial ($n $k) $s)
                        $s
                        (i64_to_string (div_i64 (i64_from_string $p1) (i64_from_string $p2)))
                    )
                    (+
                        (exec (6)
                            (, (dbcount $db $dbcount) (countedpattern $pattern $ptrncount) (cal_binomial ($dbcount $ptrncount) $calbin))
                            (, (total_count ($db $pattern) $calbin))
                        )
                    )
                )
            )
        )
    )
)








; Base permutation values
(permutation (1 1) 1)
(permutation (1 0) 1)


(permutation0
        (, (permutation ($num1 $num2) $per) (permutation ($n1 $n2)) (permutation2 $p $t))
        (O
                (- (permutation ($num1 $num2)))
                (- (permutation ($n1 $n2)))
                (pure
                    (($n1 $m) permutation ($n1 $n2) $n1)
                    $m
                    (i64_to_string (sub_i64 (i64_from_string $n1) (i64_from_string $n2)))
                )
                (+ (exec 1 $p $t))
        )
)

(permutation1 
       (, (($n $m) permutation ($n1 $n2) $per) (permutation2 $p $t))
    (O
        (- (($n $m) permutation ($n1 $n2) $per))
        (pure
            (($n $m) permutation ($n1 $n2) $a)
            $a
            (i64_to_string (product_i64 (i64_from_string $n) (i64_from_string $per)))
        )
        (+ (exec 1 $p $t))
    ) 
)


(permutation2
        (, (($n $m) permutation ($n1 $n2) $per) (permutation1 $p $t))
        (O
                (- (($n $m) permutation ($n1 $n2) $per))
                (pure
                        (($a $m) permutation ($n1 $n2) $per)
                        $a
                        (i64_to_string (sub_i64 (i64_from_string $n) (i64_from_string 1)))
                )
                (+ (exec 1 $p $t))
                (+ (exec 0 
                        (, (($m $m) permutation ($n1 $n2) $per)) 
                        (O 
                                (- (($m $m) permutation ($n1 $n2) $per)) 
                                (+ (permutation ($n1 $n2) $per))
                        )
                ))
        )
)

